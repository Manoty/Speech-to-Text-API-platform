{
  "info": {
    "name": "Speech-to-Text Platform API",
    "description": "Complete API collection for the STT Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "job_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"user@example.com\", \"password\": \"Password1\", \"full_name\": \"Test User\"}"
            }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var r = pm.response.json();",
                "pm.collectionVariables.set('access_token', r.access_token);",
                "pm.collectionVariables.set('refresh_token', r.refresh_token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"user@example.com\", \"password\": \"Password1\"}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Transcriptions",
      "item": [
        {
          "name": "Upload Audio",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var r = pm.response.json();",
                "pm.collectionVariables.set('job_id', r.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/transcriptions/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "language", "value": "en", "type": "text" },
                { "key": "model_size", "value": "base", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/transcriptions/{{job_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transcriptions/?page=1&page_size=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "status", "value": "completed", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Search Transcripts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/transcriptions/search?q=hello+world",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Export SRT",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/transcriptions/{{job_id}}/export?format=srt",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Retranscribe",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/transcriptions/{{job_id}}/retranscribe",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"model_size\": \"small\", \"language\": \"en\"}"
            }
          }
        },
        {
          "name": "Version History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/transcriptions/{{job_id}}/history",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/api-keys/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": \"My Server Key\"}" }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/api-keys/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhooks/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"url\": \"https://your-server.com/webhook\", \"secret\": \"mysecret\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Platform Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/analytics/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Cost Dashboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/costs/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}